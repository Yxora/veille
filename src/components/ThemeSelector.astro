---
import type { Category } from '../lib/types';

const { categories } = Astro.props as { categories: Category[] };
---

<div class="flex items-center gap-2">
  <label for="theme-select" class="text-sm text-zinc-400 whitespace-nowrap">Thème :</label>
  <select
    id="theme-select"
    class="bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm text-zinc-100 focus:outline-none focus:ring-1 focus:ring-indigo-400 cursor-pointer"
  >
    <option value="">— Tout voir —</option>
    {categories.map((cat) => (
      <option value={cat.id}>{cat.name}</option>
    ))}
  </select>
</div>

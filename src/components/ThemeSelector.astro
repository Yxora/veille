<details class="relative">
  <summary class="cursor-pointer select-none bg-zinc-800 border border-zinc-700 rounded-lg px-3 py-1.5 text-sm text-zinc-100 list-none">
    Mots clés ▾
  </summary>
  <div
    id="keywords-filter-panel"
    class="absolute z-10 top-full mt-1 bg-zinc-800 border border-zinc-700 rounded-xl p-3 shadow-xl min-w-[260px] max-h-96 overflow-y-auto flex flex-col gap-2"
  >
    <label class="flex items-center gap-2 text-sm pb-2 border-b border-zinc-700 cursor-pointer">
      <input type="checkbox" id="saved-filter-toggle" class="accent-indigo-400" />
      <span>🔖 Contenu sauvegardé</span>
    </label>
    <!-- Categories + keywords are rendered client-side by island.ts, since
         categories can be added/edited/deleted at runtime. -->
  </div>
</details>

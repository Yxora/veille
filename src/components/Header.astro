---
const logoSrc = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/veilleuse-icon.png`;
---
<header class="sticky top-0 z-20 bg-zinc-900/90 backdrop-blur border-b border-zinc-800">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center gap-3">
    <img src={logoSrc} alt="Veilleuse" class="h-8 w-8 rounded-full object-cover" />
    <span class="text-xl font-bold text-indigo-400">Veilleuse</span>
    <div class="flex items-center gap-1" id="env-switcher" role="group" aria-label="Environnement">
      <button
        class="env-btn px-3 py-1 text-xs font-semibold rounded-full transition"
        data-env="tech"
        aria-pressed="true"
      >Tech</button>
      <button
        class="env-btn px-3 py-1 text-xs font-semibold rounded-full transition"
        data-env="humanites"
        aria-pressed="false"
      >Humanités</button>
    </div>
    <span class="text-xs text-zinc-500" id="env-label">tech dashboard</span>
  </div>
</header>

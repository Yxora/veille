---
---

<dialog
  id="add-source-modal"
  class="bg-zinc-800 text-zinc-100 rounded-2xl p-6 w-full max-w-md shadow-2xl backdrop:bg-black/60 open:flex open:flex-col gap-4"
>
  <h2 class="text-lg font-bold">Nouvelle source</h2>
  <form id="add-source-form" class="flex flex-col gap-4">
    <input name="name" placeholder="Nom de la source" required class="input" />
    <input name="url" type="url" placeholder="URL du flux (RSS, API…)" required class="input" />
    <div>
      <label class="block text-sm text-zinc-400 mb-1">Type</label>
      <select name="type" class="input">
        <option value="rss">RSS / Atom</option>
        <option value="devto">Dev.to</option>
        <option value="reddit">Reddit</option>
        <option value="youtube">YouTube</option>
      </select>
    </div>
    <div>
      <label class="block text-sm text-zinc-400 mb-1">Environnement</label>
      <select name="environment" id="source-environment-select" class="input"></select>
    </div>
    <div class="flex justify-end gap-3 pt-2">
      <button type="button" id="cancel-source" class="btn-ghost">Annuler</button>
      <button type="submit" class="btn-primary">Ajouter</button>
    </div>
  </form>
</dialog>

---
---
<dialog
  id="manage-modal"
  class="bg-zinc-800 text-zinc-100 rounded-2xl p-6 w-full max-w-lg shadow-2xl backdrop:bg-black/60 open:flex open:flex-col gap-4"
>
  <h2 class="text-lg font-bold">Gérer sources et thèmes</h2>
  <div>
    <h3 class="text-sm font-semibold text-zinc-400 mb-2">Sources</h3>
    <div id="manage-sources-list" class="flex flex-col gap-1 max-h-48 overflow-y-auto"></div>
  </div>
  <div>
    <h3 class="text-sm font-semibold text-zinc-400 mb-2">Thèmes</h3>
    <div id="manage-categories-list" class="flex flex-col gap-1 max-h-48 overflow-y-auto"></div>
  </div>
  <div class="flex justify-end pt-2">
    <button type="button" id="close-manage" class="btn-ghost">Fermer</button>
  </div>
</dialog>

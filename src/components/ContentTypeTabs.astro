---
---
<nav class="flex gap-1 border-b border-zinc-700 mb-6" aria-label="Type de contenu">
  {[
    { value: 'all',     label: 'Tout',     icon: '🗂️' },
    { value: 'article', label: 'Articles', icon: '📄' },
    { value: 'video',   label: 'Vidéos',   icon: '🎬' },
    { value: 'podcast', label: 'Podcasts', icon: '🎙️' },
  ].map(({ value, label, icon }) => (
    <button
      class="content-type-tab px-4 py-2 text-sm font-medium rounded-t-lg transition -mb-px border border-transparent text-zinc-400 hover:text-zinc-100"
      data-type={value}
      aria-selected="false"
    >
      {icon} {label} <span class="tab-count text-xs text-zinc-500 ml-1" data-type={value}></span>
    </button>
  ))}
</nav>
